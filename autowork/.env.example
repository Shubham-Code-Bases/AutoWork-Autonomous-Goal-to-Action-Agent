# AutoWork Environment Configuration
# Duplicate this file to .env and configure your credentials.

# -----------------------------------------------------------------------------
# Option 1: Direct Gemini API (Fastest Local Setup)
# -----------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=False
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.5-flash

# -----------------------------------------------------------------------------
# Option 2: Google Cloud Vertex AI (Enterprise Mode)
# -----------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# MODEL_NAME=gemini-3.5-flash

# -----------------------------------------------------------------------------
# AutoWork Advanced Settings
# -----------------------------------------------------------------------------
AUTOWORK_TEMPERATURE=0.2
PLANNER_MODEL=gemini-3.5-flash
MAX_RESEARCH_ITERATIONS=3
MAX_SEARCHES=15
